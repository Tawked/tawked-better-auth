{
  "name": "@tawked/better-auth",
  "version": "0.1.0",
  "description": "Better Auth plugin: phone number sign-in with SMS OTP codes for Saudi numbers by Tawked Verify, and Better Auth's emails through Tawked Email.",
  "license": "MIT",
  "author": "Tawked",
  "homepage": "https://docs.tawked.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tawked/tawked-better-auth.git"
  },
  "bugs": {
    "url": "https://github.com/tawked/tawked-better-auth/issues"
  },
  "keywords": [
    "tawked",
    "better-auth",
    "better-auth-plugin",
    "authentication",
    "phone-number",
    "phone-auth",
    "phone-verification",
    "otp",
    "sms",
    "sms-otp",
    "2fa",
    "email-otp",
    "email",
    "saudi-arabia",
    "ksa",
    "arabic"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run typecheck:dist && npm run smoke",
    "typecheck:dist": "tsc --noEmit -p scripts/tsconfig.consumer.json"
  },
  "dependencies": {
    "@tawked/sdk": "^0.1.0"
  },
  "peerDependencies": {
    "better-auth": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "better-auth": "1.7.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
